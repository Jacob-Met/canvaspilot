  "sourceInverse": {
    "removedText": "    def parse_html_declaration(self, i: int) -> int:\n        # Newer HTMLParser releases treat unknown marked sections as bogus\n        # comments. Keep the established refusal instead of silently omitting\n        # unsupported source; dispatch in parser context, never scan raw HTML.\n        if self.rawdata.startswith(\"<![\", i):\n            return self.parse_marked_section(i)\n        return super().parse_html_declaration(i)\n\n",
    "baselineSha256": "005a837c10bb185edf0bcc75c3ab50609f6afbe49d38161e841380116ab97bd7",
