+def cli_result_lines(stderr):
+    """Keep errors; admit only the existing loopback HTTPX INFO diagnostic."""
+    diagnostic = re.compile(
+        r'HTTP Request: GET http://127\.0\.0\.1:[0-9]+/api/v1/conversations'
+        r'(?:/[0-9]+)?(?:\?[^"\s]*)? "HTTP/1\.0 [1-5][0-9]{2} [^"]+"'
+    )
+    return [line for line in stderr.splitlines() if not diagnostic.fullmatch(line)]
+
